{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Editable PIU chart metadata",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "review_status": {
      "enum": [
        "unreviewed_draft",
        "reviewed"
      ]
    },
    "regions": {
      "type": "array",
      "description": "Human-authored handling by half-open song-time intervals, independent of recording offsets.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "start_seconds",
          "end_seconds",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "end_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "processing": {
            "enum": [
              "standard",
              "exclude_timing",
              "hold_state_only"
            ],
            "default": "standard"
          },
          "check_exceptions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "timing_evidence",
                "stage_grade_totals",
                "note_type_conflict",
                "note_type_unresolved",
                "note_visibility",
                "scroll_motion",
                "timing_reconstruction"
              ]
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "string"
          }
        }
      }
    },
    "gimmick_candidates": {
      "type": "array",
      "description": "Scoped effects apply provisionally while pending or confirmed; rejected effects are inactive.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "start_seconds",
          "end_seconds",
          "review_status",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "end_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "review_status": {
            "enum": [
              "pending",
              "confirmed",
              "rejected"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "combo_increment": {
            "type": "integer",
            "minimum": 2,
            "maximum": 10
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "speed_multiplier": {
            "type": "number",
            "minimum": 0
          },
          "pause_duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "boundary_uncertainty_seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.1
          },
          "speed_ratio_range": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "transition_range_seconds": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "suspected_multi_increment"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "combo_increment"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "scroll_pause"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "speed_multiplier",
                "pause_duration_seconds",
                "boundary_uncertainty_seconds"
              ],
              "properties": {
                "speed_multiplier": {
                  "const": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "scroll_speed_change"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "speed_multiplier",
                "speed_ratio_range",
                "transition_range_seconds"
              ],
              "properties": {
                "speed_multiplier": {
                  "exclusiveMinimum": 0
                }
              }
            }
          }
        ]
      }
    },
    "row_assertions": {
      "type": "array",
      "description": "Reviewed chart facts; all specified cells must match one row within the half-open song-time window.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "start_seconds",
          "end_seconds",
          "cells",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "end_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "cells": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^[0-9]+$"
            },
            "additionalProperties": {
              "enum": [
                ".",
                "X",
                "M",
                "H",
                "W"
              ]
            }
          }
        }
      }
    }
  }
}
