{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Editable PIU chart metadata",
  "type": "object",
  "properties": {
    "schema": {
      "const": 1
    },
    "review_status": {
      "enum": [
        "unreviewed_draft",
        "reviewed"
      ]
    },
    "regions": {
      "type": "array",
      "description": "Human-authored handling by half-open song-time intervals, independent of recording offsets.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "start_seconds",
          "end_seconds",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "end_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "processing": {
            "enum": [
              "standard",
              "exclude_timing",
              "hold_state_only"
            ],
            "default": "standard"
          },
          "check_exceptions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "timing_evidence",
                "stage_grade_totals",
                "note_type_conflict",
                "note_type_unresolved",
                "note_visibility",
                "scroll_motion",
                "timing_reconstruction"
              ]
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "details": {
            "type": "string"
          }
        }
      }
    },
    "gimmick_candidates": {
      "type": "array",
      "description": "Scoped effects apply provisionally while pending or confirmed; rejected effects are inactive.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "start_seconds",
          "end_seconds",
          "review_status",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "end_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "review_status": {
            "enum": [
              "pending",
              "confirmed",
              "rejected"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "combo_increment": {
            "type": "integer",
            "minimum": 2,
            "maximum": 10
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "object_role_frames": {
                  "type": "array",
                  "minItems": 1,
                  "description": "Source-observed roles at uncertain effect boundaries; each pair identifies one original frame.",
                  "items": {
                    "type": "object",
                    "required": [
                      "playback_seconds",
                      "source_pts_seconds",
                      "role"
                    ],
                    "properties": {
                      "playback_seconds": {
                        "type": "number",
                        "minimum": 0
                      },
                      "source_pts_seconds": {
                        "type": "number"
                      },
                      "role": {
                        "enum": [
                          "ordinary_candidate",
                          "decorative_art"
                        ]
                      }
                    }
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "required": [
                      "object_role_frames"
                    ]
                  },
                  "then": {
                    "required": [
                      "source_id",
                      "segment_number",
                      "player",
                      "media_size_bytes",
                      "media_mtime_ns"
                    ],
                    "properties": {
                      "source_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "segment_number": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "player": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "media_size_bytes": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "media_mtime_ns": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                }
              ]
            }
          },
          "speed_multiplier": {
            "type": "number",
            "minimum": 0
          },
          "pause_duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "boundary_uncertainty_seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.1
          },
          "speed_ratio_range": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "transition_range_seconds": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": 0
            }
          },
          "note_semantics": {
            "type": "string"
          },
          "playable_notes_present": {
            "type": "boolean"
          },
          "chart_processing": {
            "enum": ["objects", "skip_non_playable_interval"]
          },
          "display_content": {
            "type": "string",
            "minLength": 1
          },
          "game_image_bounds": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "description": "Normalized game-image x, y, width, height; scope must lie entirely in the game image."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "suspected_multi_increment"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "combo_increment"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "scroll_pause"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "speed_multiplier",
                "pause_duration_seconds",
                "boundary_uncertainty_seconds"
              ],
              "properties": {
                "speed_multiplier": {
                  "const": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "scroll_speed_change"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "speed_multiplier",
                "speed_ratio_range",
                "transition_range_seconds"
              ],
              "properties": {
                "speed_multiplier": {
                  "exclusiveMinimum": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "decorative_note_art"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "note_semantics",
                "playable_notes_present",
                "game_image_bounds",
                "boundary_uncertainty_seconds",
                "display_content"
              ],
              "properties": {
                "note_semantics": {
                  "const": "decorative_non_playable"
                },
                "playable_notes_present": {
                  "const": false
                }
              }
            }
          }
        ]
      }
    },
    "row_assertions": {
      "type": "array",
      "description": "Reviewed chart facts; all specified cells must match one row within the half-open song-time window.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "start_seconds",
          "end_seconds",
          "cells",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "start_seconds": {
            "type": "number",
            "minimum": 0
          },
          "end_seconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "cells": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^[0-9]+$"
            },
            "additionalProperties": {
              "enum": [
                ".",
                "X",
                "M",
                "H",
                "W"
              ]
            }
          }
        }
      }
    }
  }
}
