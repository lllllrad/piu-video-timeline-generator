{
  "name": "piu-video-timeline-generator",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "python3 scripts/editor/prepare.py",
    "quality": "sh scripts/run.sh pnpm exec qg check",
    "quality:full": "sh scripts/run.sh pnpm exec qg check --full",
    "typecheck": "tsc --project tsconfig.json && tsc --project web/review/tsconfig.json --noEmit",
    "test": "sh scripts/run.sh pnpm exec qg check --full"
  },
  "devDependencies": {
    "@slop-lab/qg": "0.1.0",
    "@slop-lab/qg-rules-js": "0.1.0",
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.10.0",
  "dependencies": {
    "@piu/chart-editor": "file:.local/editor/piu-chart-editor-35817de29e2c.tgz"
  }
}
