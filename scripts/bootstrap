#!/bin/sh
set -eu
PIU_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
. "$PIU_ROOT/scripts/env.sh"
cd "$PIU_ROOT"
if [ "${PIU_USE_MISE:-0}" = 1 ]; then
  if [ ! -x "$PIU_ROOT/.local/mise_home/bin/mise" ]; then
    mkdir -p "$PIU_ROOT/.local/mise_home/bin"
    curl -fsSL --retry 3 https://mise.run -o "$TMPDIR/mise-install.sh"
    MISE_VERSION=v2026.8.14 MISE_INSTALL_PATH="$PIU_ROOT/.local/mise_home/bin/mise" \
      sh "$TMPDIR/mise-install.sh"
  fi
  ./scripts/mise trust "$PIU_ROOT/mise.toml"
  ./scripts/mise install
  ./scripts/mise reshim
fi
PYTHON=${PYTHON:-python3}
command -v "$PYTHON" >/dev/null || { echo "Python 3.12 is required (or use PIU_USE_MISE=1)." >&2; exit 1; }
command -v ffmpeg >/dev/null || { echo "FFmpeg is required (or use PIU_USE_MISE=1)." >&2; exit 1; }
command -v ffprobe >/dev/null || { echo "ffprobe is required (or use PIU_USE_MISE=1)." >&2; exit 1; }
command -v deno >/dev/null || { echo "Deno is required for reliable YouTube downloads (or use PIU_USE_MISE=1)." >&2; exit 1; }
command -v just >/dev/null || { echo "just is required (or use PIU_USE_MISE=1)." >&2; exit 1; }
"$PYTHON" -c 'import sys; raise SystemExit(sys.version_info[:2] != (3, 12))' || {
  echo "Python 3.12 is required (or use PIU_USE_MISE=1)." >&2; exit 1;
}
if [ ! -x .venv/bin/python ]; then
  "$PYTHON" -m venv .venv
fi
.venv/bin/python -m pip install --disable-pip-version-check -r requirements-dev.txt
.venv/bin/python scripts/configure_codex.py
sh scripts/run.sh .venv/bin/python -m unittest discover -s tests -v
